# Producción GCIA (pagos.exelixitech.com) usa scripts/build-prod.sh con VITE_APP_BASE=/.
# Por defecto para QA (nexusqa/cierrelmds) y CI el módulo se monta bajo /pagos/.
VITE_APP_BASE=/pagos/
VITE_DEPLOY_PREFIX=/pagos
VITE_NEXUS_API_URL=https://nexus-api.exelixitech.com

# Requiere verificar pago móvil antes de emitir RCV
VITE_SKIP_PAYMENT_VERIFY=false