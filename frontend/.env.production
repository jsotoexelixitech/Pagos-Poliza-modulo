# Build producción — rutas relativas (compatible con Apache ProxyPass con o sin strip)
# Mismo criterio que emision (./). NO usar /pagos/ absoluto: provoca 302 si Apache hace strip.
VITE_APP_BASE=./
VITE_NEXUS_API_URL=https://cierrelmds.exelixitech.com/nexus-api

# Requiere verificar pago móvil antes de emitir RCV
VITE_SKIP_PAYMENT_VERIFY=false
