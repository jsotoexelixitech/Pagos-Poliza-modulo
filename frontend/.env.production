# Producción GCIA: scripts/build-prod.sh (VITE_APP_BASE=/ y nexus-api.exelixitech.com).
# QA/cierre: no hornear GCIA. En HTTPS el front usa {origin}/nexus-api.
# En pagos.exelixitech.com, nexus-core fuerza el subdominio de producción.
VITE_APP_BASE=/pagos/
VITE_DEPLOY_PREFIX=/pagos
VITE_NEXUS_API_URL=

# Requiere verificar pago móvil antes de emitir RCV
VITE_SKIP_PAYMENT_VERIFY=false
