# ── Build local (dev) ──────────────────────────────────────────────────────────
# cierrelmds:  /pagos/
VITE_APP_BASE=/

# URL de nexus-api (SSO, verify, bridge)
# Local:       http://localhost:3092
# cierrelmds:  https://cierrelmds.exelixitech.com/nexus-api
VITE_NEXUS_API_URL=https://cierrelmds.exelixitech.com/nexus-api

# API Key de empresa (opcional en dev)
VITE_NEXUS_API_KEY=

# QA: omitir verificación de pago para probar emisión RCV
# QA temporal: omitir verificación de pago móvil (solo pruebas locales; usar false en srv001)
VITE_SKIP_PAYMENT_VERIFY=false
