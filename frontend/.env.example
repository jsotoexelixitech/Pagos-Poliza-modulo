# ── Build local (dev) ──────────────────────────────────────────────────────────
# cierrelmds:  /pagos/
VITE_APP_BASE=/

# URL de nexus-api (SSO, verify, bridge)
# Local: no apuntar a srv120 (CORS). Usar localhost o dejar el guard desactivado en DEV.
# Local:       http://localhost:3092
# cierrelmds:  https://cierrelmds.exelixitech.com/nexus-api
VITE_NEXUS_API_URL=http://localhost:3092

# API Key de empresa (opcional en dev)
VITE_NEXUS_API_KEY=

# QA: simular verificación de pago móvil (sin banco; emite como pagada con ref SIM-*)
# Activar solo en pruebas locales; usar false en srv001 producción
VITE_SKIP_PAYMENT_VERIFY=false
