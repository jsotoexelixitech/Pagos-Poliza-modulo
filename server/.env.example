# ─── Modulo Pagos · Backend ────────────────────────────────────────────
PORT=4003
CORS_ORIGINS=*
JSON_BODY_LIMIT=1mb

# ─── Módulo Emisión (proxy) ────────────────────────────────────────────
# El servidor de pagos reenvía /api/policies/emit y /api/policies/quote
# al backend de emisión. Ajustar si corre en otro host/puerto.
EMISION_API_URL=http://localhost:4004

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
# Si true, todos los endpoints /api/payments/* requieren nexus_token valido.
NEXUS_AUTH_ENABLED=true
# Mismo secret configurado en nexus-api (TENANT_TOKEN_SECRET).
TENANT_TOKEN_SECRET=
# Id del submodulo Pagos Poliza en la BD de nexus.
NEXUS_EXPECTED_SUBMODULO_ID=20

# ─── MERITOP (Banco Activo) ─────────────────────────────────────────────
MERITOP_URL=http://172.30.147.26:9020
MERITOP_URL2=http://172.30.149.18:9040
MERITOP_APIKEY=
MERITOP_IP=
MERITOP_USERNAME=
MERITOP_PASSWORD=
MERITOP_BANK=
MERITOP_CHANNEL=
MERITOP_TERMINAL=
MERITOP_ENABLED=true
MERITOP_TIMEOUT=15000
# true = simula respuesta (para desarrollo sin VPN al banco).
MERITOP_MOCK=true

# ─── SYPAGO (Debito OTP) ────────────────────────────────────────────────
SYPAGO_URL=https://pruebas.sypago.net:8086
SYPAGO_BEARER_TOKEN=
SYPAGO_BANK_CODE=0108
SYPAGO_TYPE=CNTA
SYPAGO_NUMBER=
SYPAGO_WEBHOOK_URL=
SYPAGO_MOCK=true
SYPAGO_TIMEOUT=20000
