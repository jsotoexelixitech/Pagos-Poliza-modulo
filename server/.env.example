# ─── Modulo Pagos · Backend ────────────────────────────────────────────
PORT=4003
CORS_ORIGINS=http://localhost:5184,*
JSON_BODY_LIMIT=1mb

# ─── Módulo Emisión (proxy) ────────────────────────────────────────────
# El servidor de pagos reenvía /api/policies/emit y /api/policies/quote
# al backend de emisión. Ajustar si corre en otro host/puerto.
EMISION_API_URL=http://localhost:4004

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
# Si true, todos los endpoints /api/payments/* requieren nexus_token valido.
NEXUS_AUTH_ENABLED=true
# Mismo secret configurado en nexus-api (TENANT_TOKEN_SECRET).
TENANT_TOKEN_SECRET=
# Id del submodulo Pagos Poliza en la BD de nexus.
# 20=Pagos RCV · 24=Pagos Funerario · 32=Pagos Catálogo Exélixi
NEXUS_EXPECTED_SUBMODULO_IDS=20,24,32

# ─── Pago móvil — SysIP La Mundial (Meritop vía Bancamiga) ───────────────
# Endpoint: POST {LAMUNDIAL_PAYMENTS_URL}{LAMUNDIAL_PAYMENTS_PATH}
# Misma ruta que SysIP front (bancamiga-mobile-pay.component.ts).
# NO usar nest-api :3002 ni NEST_API_URL (nest-api no tiene esta ruta).
LAMUNDIAL_PAYMENTS_URL=https://apisys2000.lamundialdeseguros.com
LAMUNDIAL_PAYMENTS_PATH=/api/v1/bancamiga/meritop/find-mobile-pay
# Opcional — la ruta meritop no exige apikey; solo external/bancoActivo la usa.
LAMUNDIAL_PAYMENTS_API_KEY=
LAMUNDIAL_PAYMENTS_DEST_PHONE=04143966962
LAMUNDIAL_PAYMENTS_DEST_BANCO=0171
LAMUNDIAL_PAYMENTS_TIMEOUT=20000
LAMUNDIAL_PAYMENTS_ENABLED=true
LAMUNDIAL_PAYMENTS_MOCK=false

# ─── SYPAGO (Debito OTP) ────────────────────────────────────────────────
# Host segun documentacion oficial (ambiente de pruebas).
SYPAGO_URL=https://pruebas.api.sypago.net

# Autenticacion: usar UNA de las dos modalidades.
#  a) JWT fijo (token sin expiracion entregado por SyPago):
SYPAGO_BEARER_TOKEN=
#  b) API Key dinamica (client_id + secret) -> POST /api/v1/auth/token:
SYPAGO_CLIENT_ID=
SYPAGO_SECRET=

# Cuenta acreedora (la del comercio en SyPago).
SYPAGO_BANK_CODE=0108
SYPAGO_TYPE=CNTA
SYPAGO_NUMBER=

# Webhook: URL publica de este backend donde SyPago notifica el resultado.
#   Debe apuntar a  https://<host>/api/payments/otp/webhook
SYPAGO_WEBHOOK_URL=
# Clave publica (PEM) de SyPago para validar la firma del webhook (X-Signature).
# Usar \n para los saltos de linea si se coloca en una sola linea.
SYPAGO_WEBHOOK_PUBLIC_KEY=

SYPAGO_MOCK=true
SYPAGO_TIMEOUT=20000

# ─── Checkout SSO — notificación al cliente (notifyUrl) ───────────────────
# Dominios permitidos para payload.notifyUrl (vacío = cualquier HTTPS).
# CHECKOUT_NOTIFY_ALLOWLIST=exelixitech.com,lamundialdeseguros.com
# En QA: permitir http:// en red interna (172.x, 192.168.x, localhost).
CHECKOUT_NOTIFY_ALLOW_PRIVATE_HTTP=true
# CHECKOUT_NOTIFY_ALLOW_HTTP=true
CHECKOUT_NOTIFY_TIMEOUT_MS=15000

NEST_API_URL=http://127.0.0.1:3002
NEST_API_KEY=
# false = no llamar collection/activate desde webhook (RCV usa emision-api post-emit)
COLLECTION_ON_WEBHOOK=false

# ─── Domiciliación (backend Nest) ─────────────────────────────────────────
# Proxy de /api/domiciliacion/* hacia el servicio de registro/afiliación SyPago.
DOMICILIACION_API_URL=https://cierrelmds.exelixitech.com/domiciliacion-services
